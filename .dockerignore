# Keep the build context small and avoid leaking local state into the image.
.git
.gitignore
.venv
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache

# Secrets and local environment
.env
.envrc

# Protocol PDFs and generated metadata: fetched from GCS at runtime, and far
# too large to ship in a container image.
data/
swg-use-cases/

# Not needed at runtime
design/
scripts/
packages/*/tests/
**/*.md
Dockerfile
.dockerignore
