%%{init: {"flowchart": {"useMaxWidth": false, "wrappingWidth": 340, "nodeSpacing": 40, "rankSpacing": 60, "padding": 18}, "themeVariables": {"fontSize": "22px"}}}%%
flowchart LR
    DR(["👤 <b>Clinician</b><br/>clinical question"])
    SCOPE(["🏥 <b>Center + protocol selection</b><br/>set once per conversation"])
    ANS(["✅ <b>Cited answer + Sources</b><br/>protocol · version · page"])

    subgraph BOX ["🤖 <b>Pediatric Oncology Assistant</b> · ADK Workflow on Agent Engine"]
        direction TB
        subgraph S1 ["<b>Guard and clarify</b>"]
            direction LR
            IN["① <b>intake</b><br/>removes patient IDs (NISS)<br/>before any LLM call"]
            G["② 🛡️ <b>scope_guard</b><br/>pediatric hem/onc only?"]
            REF(["🚫 Out-of-scope refusal"])
            C["③ ❓ <b>clarifier</b><br/>missing discriminator?"]
            ASK["<b>ask_user</b><br/>asks the clinician<br/>reply resumes the run"]

            IN --> G
            G -->|"out of scope"| REF
            G -->|"in scope"| C
            C <-->|"missing fact<br/>max 2 rounds"| ASK
        end

        subgraph S2 ["<b>Retrieve and answer</b>"]
            direction LR
            R["④ 🔎 <b>retriever</b><br/>up to 3 searches"]
            TOOL["🔧 <b>search_protocols</b><br/>FunctionTool · query text only"]
            VS[("🗄️ <b>Vertex AI Search</b> · eu<br/>layout-parsed chunks<br/>page span · headings")]
            SS[("🧠 <b>Session state</b><br/>center · selection")]
            MAN[("📋 <b>Protocol manifest</b><br/>27 protocols × 6 centers")]
            NC(["⚠️ Not covered<br/>answerer skipped"])
            A["⑤ ✍️ <b>answerer</b><br/>no tools · cites cN"]
            F["⑥ <b>finalize</b><br/>cN → protocol · version<br/>page · section"]

            R <-->|"query · passages c1..cn"| TOOL
            TOOL <-->|"filter: protocol_id ∈ selection"| VS
            TOOL -.->|"reads scope"| SS
            TOOL -.->|"selection ⊆ center scope"| MAN
            R -->|"nothing found"| NC
            R -->|"passages found"| A
            A --> F
        end

        S1 ==>|"③ clarifier ready → ④ retriever"| S2
    end

    DR ==>|"question"| BOX
    SCOPE -.->|"stored in session state"| BOX
    BOX ==>|"final answer"| ANS

    classDef actor fill:#FFE4B5,stroke:#8B4513,stroke-width:3px,color:#3E2723
    classDef agent fill:#4A90D9,stroke:#1B3A5C,stroke-width:3px,color:#FFFFFF
    classDef fn fill:#E8EAF6,stroke:#3949AB,stroke-width:3px,color:#1A237E
    classDef tool fill:#FFB74D,stroke:#E65100,stroke-width:3px,color:#3E2723
    classDef data fill:#E6E6FA,stroke:#5E35B1,stroke-width:3px,color:#1A0033
    classDef out fill:#90EE90,stroke:#1B5E20,stroke-width:3px,color:#0B3D0B
    classDef warn fill:#FFB6C1,stroke:#B71C1C,stroke-width:3px,color:#3B0A0A
    classDef lane fill:#FAFAFA,stroke:#9E9E9E,stroke-width:2px,color:#212121
    classDef box fill:#F1F8FF,stroke:#1B3A5C,stroke-width:4px,color:#0B2A4A

    class DR,SCOPE actor
    class G,C,R,A agent
    class IN,ASK,F fn
    class TOOL tool
    class SS,MAN,VS data
    class ANS out
    class REF,NC warn
    class S1,S2 lane
    class BOX box
