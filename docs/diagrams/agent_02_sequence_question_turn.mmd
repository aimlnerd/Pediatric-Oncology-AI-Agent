config:
  fontSize: 24
  themeVariables:
    fontSize: 24px
  sequence:
    useMaxWidth: false
    messageFontSize: 24
    actorFontSize: 26
    actorFontWeight: bold
    noteFontSize: 24
    width: 170
    actorMargin: 30
    messageMargin: 50
---
sequenceDiagram
    autonumber
    actor Dr as 👤 Clinician
    participant WF as ⚙️ Workflow runtime
    participant G as 🛡️ scope_guard
    participant C as ❓ clarifier
    participant R as 🔎 retriever
    participant T as 🔧 search_protocols
    participant VS as 🗄️ Vertex AI Search
    participant A as ✍️ answerer
    participant GM as 🤖 LLM on Vertex AI

    Dr->>WF: question<br/>(center + selection live in session state)
    WF->>WF: intake: redact NISS,<br/>reset turn state, add to case_notes
    WF->>G: question + case_notes
    G->>GM: is this pediatric hematology / oncology?
    GM-->>G: in_scope or refusal_text

    alt out of scope (adult medicine, asthma, ...)
        WF-->>Dr: refusal, nothing is searched
    else in scope
        WF->>C: question +<br/>catalog of selected protocols
        C->>GM: does a missing patient fact change which protocol applies?
        GM-->>C: ask or ready

        opt a discriminator is missing (max 2 rounds)
            C-->>Dr: clarifying question<br/>run pauses (RequestInput)
            Dr->>WF: reply resumes the paused run
            WF->>C: reply added to case_notes,<br/>clarifier runs again
        end

        WF->>R: question + case_notes
        loop up to 3 searches
            R->>GM: choose a clinical search query
            GM-->>R: tool call search_protocols(query)
            R->>T: query text only
            T->>T: read center + selection from state,<br/>validate against manifest
            T->>VS: search(query,<br/>filter protocol_id ANY selection,<br/>mode CHUNKS)
            VS-->>T: chunks (text, page span,<br/>headings, metadata)
            T-->>R: passages c1..cn,<br/>also stored in state
        end

        alt no passages retrieved
            WF-->>Dr: not covered in the selected protocols<br/>(answerer skipped)
        else passages found
            WF->>A: question + numbered passages
            A->>GM: answer only from<br/>the passages, cite cN
            GM-->>A: status +<br/>body_markdown
            WF->>WF: finalize: cN becomes<br/>protocol, version, pages, section
            WF-->>Dr: cited answer + Sources<br/>(uncited answers become "not covered")
        end
    end
